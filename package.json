{
  "name": "cantill-pr-to-po",
  "version": "1.0.0",
  "description": "Corvo Engineering Policy-Driven PR-to-PO Web Application (Hybrid Groq AI + Deterministic Engine)",
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && node --watch dist/server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build:server": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "seed": "npm run build:server && node dist/server/seed-cli.js",
    "test": "npm run build:tests && node --test dist-tests/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "multer": "^1.4.5-lts.1",
    "unpdf": "^0.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
